# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://autonexa:autonexa@localhost:5432/autonexa?schema=public"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Platform / Super Admin
SUPER_ADMIN_EMAIL="superadmin@autonexa.app"
SUPER_ADMIN_PASSWORD="change-me"

# Outbound messaging — each is optional; an unset provider is skipped
# (logged as DeliveryLog status SKIPPED), not an error. Platform-level
# accounts shared across all tenants, unlike Slack which is per-tenant
# (see TenantSettings.slackWebhookUrl, set via Workshop Settings).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL="no-reply@autonexa.app"
SMTP_FROM_NAME="AutoNexa"

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Meta WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Payment Gateway (Razorpay) — optional; unset hides/disables "Send Payment
# Link" on an invoice, same "quietly unavailable" posture as the messaging
# providers above. Platform-level, one shared merchant account across every
# tenant. See README's Deployment section for webhook setup steps.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FRONTEND_URL=
