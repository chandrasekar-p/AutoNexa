# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://autonexa:autonexa@localhost:5432/autonexa?schema=public"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Platform / Super Admin
SUPER_ADMIN_EMAIL="superadmin@autonexa.app"
SUPER_ADMIN_PASSWORD="change-me"

# Outbound messaging — each is optional; an unset provider is skipped
# (logged as DeliveryLog status SKIPPED), not an error. Platform-level
# accounts shared across all tenants, unlike Slack which is per-tenant
# (see TenantSettings.slackWebhookUrl, set via Workshop Settings).
#
# SMTP is a plain nodemailer transport — any SMTP-compatible provider
# works (Gmail SMTP, SendGrid, Brevo, Postmark, ...), no code changes
# needed per provider. Brevo (formerly Sendinblue) example:
   SMTP_HOST="smtp-relay.brevo.com"
   SMTP_PORT=587
   SMTP_USER=<your Brevo account login email>
   SMTP_PASSWORD=<SMTP key, from Brevo dashboard -> SMTP & API -> SMTP>
#    SMTP_HOST=
#    SMTP_PORT=587
#    SMTP_USER=
#    SMTP_PASSWORD=
#    SMTP_FROM_EMAIL="no-reply@autonexa.app"
#    SMTP_FROM_NAME="AutoNexa"

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Meta WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Payment Gateway (Razorpay) — optional; unset hides/disables "Send Payment
# Link" on an invoice, same "quietly unavailable" posture as the messaging
# providers above. Platform-level, one shared merchant account across every
# tenant. See README's Deployment section for webhook setup steps.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Where a customer-facing link should point the browser — Razorpay's
# Payment Link callback and the estimate self-approval link both use this.
FRONTEND_URL=

# Customer self-service estimate approval — REQUIRED, not optional like
# the integrations above: EstimatesService.send() (the pre-existing "send
# to customer" action) now mints a token on every call, so an unset secret
# breaks send() outright, not just a new feature. Treat like a JWT secret.
ESTIMATE_APPROVAL_SECRET=

# File storage — defaults to `local` (writes to apps/api/uploads/), the
# right fit for local dev. Set to `s3` for anything with an ephemeral or
# multi-instance filesystem; if you do, S3_BUCKET/S3_REGION/
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY become required — the app refuses
# to start with STORAGE_MODE=s3 and any of them missing, rather than
# silently falling back to local disk. S3_ENDPOINT is only needed for a
# non-AWS provider (Cloudflare R2, MinIO, ...). See README §4.
STORAGE_MODE=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
