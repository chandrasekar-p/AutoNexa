{
  "name": "@autonexa/api",
  "version": "1.1.0",
  "description": "AutoNexa Workshop Management API",
  "scripts": {
    "build": "nest build",
    "prestart": "node scripts/free-port.js 4000",
    "start": "nest start",
    "prestart:dev": "node scripts/free-port.js 4000",
    "start:dev": "nest start --watch",
    "prestart:prod": "node scripts/free-port.js 4000",
    "start:prod": "node dist/src/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "migrate:uploads-to-s3": "ts-node scripts/migrate-uploads-to-s3.ts",
    "backfill:role-permissions": "ts-node scripts/backfill-role-permissions.ts",
    "backfill:estimate-numbers": "ts-node scripts/backfill-estimate-numbers.ts",
    "backfill:customer-numbers": "ts-node scripts/backfill-customer-numbers.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --config jest.config.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.19.0",
    "argon2": "^0.40.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "twilio": "^6.1.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "jest": "^30.4.2",
    "prisma": "^5.19.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
