// AutoNexa — Phase 2 Prisma schema
// Covers: tenancy, branches, users, roles, permissions, refresh tokens, audit log.
// Later phases append models here (customers, vehicles, job-cards, inventory, billing…)
// following the same tenantId-first indexing convention.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── PLATFORM / TENANCY ─────────────────────────

model Tenant {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  gstin     String?
  planTier  String    @default("standard")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  settings         TenantSettings?
  branches         Branch[]
  users            User[]
  roles            Role[]
  auditLogs        AuditLog[]
  customers        Customer[]
  vehicles         Vehicle[]
  appointments     Appointment[]
  inspections      Inspection[]
  estimates        Estimate[]
  labourItems      LabourItem[]
  technicians      Technician[]
  jobCards         JobCard[]
  partCategories   PartCategory[]
  parts            Part[]
  suppliers        Supplier[]
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  supplierPayments SupplierPayment[]
  invoices         Invoice[]
  notifications    Notification[]

  @@map("tenants")
}

model TenantSettings {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  jobCardPrefix  String   @default("JC")
  invoicePrefix  String   @default("INV")
  estimatePrefix String   @default("EST")
  poPrefix       String   @default("PO")
  defaultGstRate Decimal  @default(18) @db.Decimal(5, 2)
  timezone       String   @default("Asia/Kolkata")
  currency       String   @default("INR")
  // The workshop's own home state — determines CGST+SGST (same state as
  // the customer) vs IGST (different state) on generated invoices. See
  // calculateGstSplit in modules/invoices/gst-split.ts for the fallback
  // behavior when this (or the customer's own state) is unset.
  state          String?
  updatedAt      DateTime @updatedAt

  @@map("tenant_settings")
}

model Branch {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  address   String?
  city      String?
  phone     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users User[]

  @@index([tenantId])
  @@map("branches")
}

// A per-tenant, per-entity sequence generator for human-readable numbers
// (job card #, invoice #, estimate #) — avoids collisions under concurrency.
model TenantSequence {
  id         String @id @default(uuid())
  tenantId   String
  entityType String // "JOB_CARD" | "INVOICE" | "ESTIMATE" | "PURCHASE_ORDER"
  lastNumber Int    @default(0)

  @@unique([tenantId, entityType])
  @@map("tenant_sequences")
}

// ───────────────────────── IDENTITY & ACCESS ─────────────────────────

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  name         String
  email        String
  passwordHash String
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  appointmentsAsAdvisor    Appointment[] @relation("AppointmentServiceAdvisor")
  appointmentsAsTechnician Appointment[] @relation("AppointmentTechnician")
  inspectionsAsTechnician  Inspection[]  @relation("InspectionTechnician")

  technician               Technician?
  jobCardsAsServiceAdvisor JobCard[]
  jobCardStatusChanges     JobCardStatusHistory[]
  jobCardNotes             JobCardNote[]

  inventoryTransactions InventoryTransaction[]
  goodsReceiptsReceived GoodsReceipt[]
  notifications         Notification[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// Roles are tenant-scoped, except system roles (tenantId = null), e.g. SUPER_ADMIN.
model Role {
  id       String  @id @default(uuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  name     String
  isSystem Boolean @default(false)

  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

// Permissions are global (resource:action pairs); tenants compose roles from them.
model Permission {
  id       String @id @default(uuid())
  resource String // e.g. "job-card", "invoice", "part"
  action   String // e.g. "create", "read", "update", "delete", "cancel"

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id])
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String
  familyId   String // groups rotated tokens; reuse-after-revoke invalidates the family
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ───────────────────────── AUDIT ─────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // e.g. "user.create", "role.assign"
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ───────────────────────── CRM (Phase 3) ─────────────────────────

model Customer {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  name         String
  mobile       String
  altMobile    String?
  email        String?
  address      String?
  city         String?
  state        String?
  gstin        String?
  customerType String    @default("individual") // "individual" | "business"
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  vehicles     Vehicle[]
  appointments Appointment[]
  estimates    Estimate[]
  jobCards     JobCard[]
  invoices     Invoice[]

  @@index([tenantId])
  @@index([tenantId, mobile])
  @@index([tenantId, name])
  @@map("customers")
}

model Vehicle {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  registrationNo  String
  vin             String?
  brand           String
  model           String
  variant         String?
  manufactureYear Int?
  fuelType        String? // "petrol" | "diesel" | "electric" | "hybrid" | "cng"
  transmission    String? // "manual" | "automatic"
  colour          String?
  odometerReading Int?
  insuranceExpiry DateTime?
  pucExpiry       DateTime?
  warrantyInfo    String?
  purchaseDate    DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  documents    VehicleDocument[]
  appointments Appointment[]
  inspections  Inspection[]
  estimates    Estimate[]
  jobCards     JobCard[]

  @@index([tenantId])
  @@index([tenantId, registrationNo])
  @@index([tenantId, customerId])
  @@index([tenantId, vin])
  @@map("vehicles")
}

// Insurance papers, RC copy, warranty card scans, etc. — metadata only;
// actual bytes live in object storage (see Phase 1 architecture, Section
// "File Storage"). `fileUrl` is a signed/reference URL, not a raw path.
model VehicleDocument {
  id         String   @id @default(uuid())
  tenantId   String
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  docType    String // "insurance" | "rc" | "puc" | "warranty" | "other"
  fileUrl    String
  fileName   String?
  uploadedAt DateTime @default(now())

  @@index([tenantId, vehicleId])
  @@map("vehicle_documents")
}

// ─────────────── FRONT-OF-HOUSE WORKFLOW (Phase 4) ───────────────

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  VEHICLE_RECEIVED
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id])
  vehicleId        String
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id])
  serviceType      String
  appointmentDate  DateTime
  appointmentTime  String
  serviceAdvisorId String?
  serviceAdvisor   User?             @relation("AppointmentServiceAdvisor", fields: [serviceAdvisorId], references: [id])
  technicianId     String?
  technician       User?             @relation("AppointmentTechnician", fields: [technicianId], references: [id])
  notes            String?
  status           AppointmentStatus @default(SCHEDULED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  inspections Inspection[]

  @@index([tenantId])
  @@index([tenantId, appointmentDate])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, vehicleId])
  @@map("appointments")
}

enum InspectionStatus {
  IN_PROGRESS
  COMPLETED
}

enum InspectionCategory {
  EXTERIOR
  INTERIOR
  MECHANICAL
}

enum InspectionResult {
  PASS
  FAIL
  NEEDS_ATTENTION
  NOT_CHECKED
}

model Inspection {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  vehicleId     String
  vehicle       Vehicle          @relation(fields: [vehicleId], references: [id])
  appointmentId String?
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id])
  technicianId  String?
  technician    User?            @relation("InspectionTechnician", fields: [technicianId], references: [id])
  status        InspectionStatus @default(IN_PROGRESS)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items    InspectionItem[]
  photos   InspectionPhoto[]
  jobCards JobCard[]

  @@index([tenantId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, appointmentId])
  @@map("inspections")
}

// Exterior/Interior/Mechanical checklist rows (Phase 1, Section 9). Created
// in bulk from a default-per-category constant when an inspection starts
// (see default-inspection-checklist.ts); ad-hoc items can still be added.
model InspectionItem {
  id           String             @id @default(uuid())
  tenantId     String
  inspectionId String
  inspection   Inspection         @relation(fields: [inspectionId], references: [id])
  category     InspectionCategory
  itemName     String
  result       InspectionResult   @default(NOT_CHECKED)
  remarks      String?

  @@index([tenantId, inspectionId])
  @@map("inspection_items")
}

// Metadata-only, same pattern as VehicleDocument — actual bytes live in
// object storage per the Phase 1 "File Storage" module.
model InspectionPhoto {
  id           String     @id @default(uuid())
  tenantId     String
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id])
  fileUrl      String
  fileName     String?
  uploadedAt   DateTime   @default(now())

  @@index([tenantId, inspectionId])
  @@map("inspection_photos")
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

model Estimate {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  vehicleId      String
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id])
  jobDescription String?
  status         EstimateStatus @default(DRAFT)
  subtotal       Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2)
  discountAmount Decimal        @default(0) @db.Decimal(12, 2)
  total          Decimal        @default(0) @db.Decimal(12, 2)
  approvedAt     DateTime?
  rejectedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  lineItems EstimateLineItem[]
  jobCard   JobCard?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, vehicleId])
  @@map("estimates")
}

enum EstimateLineItemType {
  LABOUR
  PART
  CONSUMABLE
}

// lineTotal is quantity × unitPrice (pre-tax); GST is aggregated onto the
// parent Estimate's taxAmount, not stored per line — see estimate-totals.ts.
// Recalculated server-side on every line-item add/update/remove, never
// trusted from the client.
model EstimateLineItem {
  id          String               @id @default(uuid())
  tenantId    String
  estimateId  String
  estimate    Estimate             @relation(fields: [estimateId], references: [id])
  itemType    EstimateLineItemType
  description String
  quantity    Decimal              @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal              @db.Decimal(12, 2)
  gstRate     Decimal              @default(18) @db.Decimal(5, 2)
  lineTotal   Decimal              @db.Decimal(12, 2)

  @@index([tenantId, estimateId])
  @@map("estimate_line_items")
}

// ─────────────── OPERATIONAL CORE (Phase 5) ───────────────

model LabourItem {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  code               String
  description        String
  standardHours      Decimal   @db.Decimal(6, 2)
  labourRate         Decimal   @db.Decimal(10, 2)
  gstRate            Decimal   @default(18) @db.Decimal(5, 2)
  technicianCategory String?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  jobCardLabours JobCardLabour[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("labour_items")
}

enum TechnicianStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

// A technician IS a User with the Technician role — this table is their
// operational profile (skills, workload), not a separate identity. No
// deletedAt: deactivation goes through `status` (INACTIVE), not soft delete.
model Technician {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id])
  employeeId      String?
  skills          String[]
  specialisation  String?
  experienceYears Int?
  status          TechnicianStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  jobCards JobCard[]

  @@index([tenantId])
  @@map("technicians")
}

enum JobCardStatus {
  OPEN
  DIAGNOSIS
  WAITING_APPROVAL
  APPROVED
  IN_PROGRESS
  WAITING_PARTS
  QUALITY_CHECK
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model JobCard {
  id            String @id @default(uuid())
  tenantId      String
  tenant        Tenant @relation(fields: [tenantId], references: [id])
  jobCardNumber String

  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  // Denormalized from vehicle.customerId for query convenience — same
  // pattern as Appointment.
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Optional: walk-ins skip estimates entirely.
  estimateId String?   @unique
  estimate   Estimate? @relation(fields: [estimateId], references: [id])

  inspectionId String?
  inspection   Inspection? @relation(fields: [inspectionId], references: [id])

  technicianId String?
  technician   Technician? @relation(fields: [technicianId], references: [id])

  serviceAdvisorId String?
  serviceAdvisor   User?   @relation(fields: [serviceAdvisorId], references: [id])

  odometer        Int?
  complaint       String?
  customerRequest String?
  estimatedWork   String?

  status           JobCardStatus @default(OPEN)
  startAt          DateTime?
  expectedDelivery DateTime?
  actualDelivery   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  labourItems   JobCardLabour[]
  statusHistory JobCardStatusHistory[]
  notes         JobCardNote[]
  parts         JobCardPart[]
  invoice       Invoice?

  @@unique([tenantId, jobCardNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, vehicleId])
  @@index([tenantId, customerId])
  @@index([tenantId, technicianId])
  @@map("job_cards")
}

// labourItemId is nullable, not strictly required: Estimate -> Job Card
// conversion (job-cards.service.ts createFromEstimate) looks up a matching
// LabourItem by description for categorization/reporting only — rate and
// gstRate always come from the estimate line's own approved unitPrice/
// gstRate, never from the catalogue match, since that's the price the
// customer actually approved (approved-price integrity, not live catalogue
// pricing). No match still means no labourItemId rather than fabricating a
// synthetic LabourItem row. POST /job-cards/:id/labour, the direct-add
// endpoint with no estimate behind it, uses live catalogue pricing and
// still requires labourItemId via its DTO.
model JobCardLabour {
  id           String      @id @default(uuid())
  tenantId     String
  jobCardId    String
  jobCard      JobCard     @relation(fields: [jobCardId], references: [id])
  labourItemId String?
  labourItem   LabourItem? @relation(fields: [labourItemId], references: [id])
  description  String?
  hours        Decimal     @db.Decimal(6, 2)
  rate         Decimal     @db.Decimal(10, 2)
  gstRate      Decimal     @db.Decimal(5, 2)
  lineTotal    Decimal     @db.Decimal(12, 2)

  @@index([tenantId, jobCardId])
  @@map("job_card_labour")
}

// Append-only domain timeline (shown on the job card's UI timeline), not
// just a compliance log like AuditLog — no updatedAt/deletedAt, rows are
// never edited or removed.
model JobCardStatusHistory {
  id              String         @id @default(uuid())
  tenantId        String
  jobCardId       String
  jobCard         JobCard        @relation(fields: [jobCardId], references: [id])
  fromStatus      JobCardStatus?
  toStatus        JobCardStatus
  changedByUserId String?
  changedByUser   User?          @relation(fields: [changedByUserId], references: [id])
  changedAt       DateTime       @default(now())
  notes           String?

  @@index([tenantId, jobCardId])
  @@map("job_card_status_history")
}

model JobCardNote {
  id        String   @id @default(uuid())
  tenantId  String
  jobCardId String
  jobCard   JobCard  @relation(fields: [jobCardId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  note      String
  createdAt DateTime @default(now())

  @@index([tenantId, jobCardId])
  @@map("job_card_notes")
}

// ─────────────── PARTS & INVENTORY (Phase 6) ───────────────

model PartCategory {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  deletedAt DateTime?

  parts Part[]

  @@index([tenantId])
  @@map("part_categories")
}

model Part {
  id                   String        @id @default(uuid())
  tenantId             String
  tenant               Tenant        @relation(fields: [tenantId], references: [id])
  partNumber           String
  sku                  String
  name                 String
  categoryId           String?
  category             PartCategory? @relation(fields: [categoryId], references: [id])
  brand                String?
  vehicleCompatibility String? // freeform for now
  supplierId           String? // primary/preferred supplier
  supplier             Supplier?     @relation(fields: [supplierId], references: [id])
  purchasePrice        Decimal       @db.Decimal(12, 2)
  sellingPrice         Decimal       @db.Decimal(12, 2)
  gstRate              Decimal       @default(18) @db.Decimal(5, 2)
  currentStock         Int           @default(0)
  minStock             Int           @default(0)
  maxStock             Int?
  binLocation          String?
  warrantyPeriodMonths Int?
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  transactions       InventoryTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  jobCardParts       JobCardPart[]

  @@unique([tenantId, partNumber])
  @@index([tenantId])
  @@index([tenantId, sku])
  @@index([tenantId, categoryId])
  @@index([tenantId, supplierId])
  @@map("parts")
}

enum InventoryTxnType {
  PURCHASE_IN
  JOB_CARD_CONSUMPTION
  SALE
  RETURN
  ADJUSTMENT
  DAMAGED
  TRANSFER
}

// Append-only ledger, same spirit as JobCardStatusHistory — no update or
// delete. `quantity` is signed (positive = stock in, negative = stock out),
// so Part.currentStock is always re-derivable as the sum of this table for
// that part; currentStock itself is a denormalized running total kept in
// sync by every mutation, not the source of truth.
model InventoryTransaction {
  id          String           @id @default(uuid())
  tenantId    String
  partId      String
  part        Part             @relation(fields: [partId], references: [id])
  type        InventoryTxnType
  quantity    Int
  refType     String? // "JobCard" | "PurchaseOrder" | "Adjustment"
  refId       String?
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id])
  notes       String?
  createdAt   DateTime         @default(now())

  @@index([tenantId, partId])
  @@index([tenantId, createdAt])
  @@map("inventory_transactions")
}

model Supplier {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  name          String
  contactPerson String?
  mobile        String?
  email         String?
  address       String?
  gstin         String?
  paymentTerms  String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  parts          Part[]
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// No deletedAt — CANCELLED is the terminal/withdrawn state, same pattern as
// JobCard's own CANCELLED status.
model PurchaseOrder {
  id                   String              @id @default(uuid())
  tenantId             String
  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  poNumber             String
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  status               PurchaseOrderStatus @default(DRAFT)
  expectedDeliveryDate DateTime?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  items            PurchaseOrderItem[]
  goodsReceipts    GoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  tenantId         String
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  partId           String
  part             Part          @relation(fields: [partId], references: [id])
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Decimal       @db.Decimal(12, 2)
  gstRate          Decimal       @db.Decimal(5, 2)
  lineTotal        Decimal       @db.Decimal(12, 2)

  goodsReceiptItems GoodsReceiptItem[]

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  tenantId        String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedById    String?
  receivedBy      User?         @relation(fields: [receivedById], references: [id])
  receivedAt      DateTime      @default(now())
  notes           String?

  items GoodsReceiptItem[]

  @@index([tenantId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String            @id @default(uuid())
  tenantId            String
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id])
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  quantityReceived    Int

  @@index([tenantId, goodsReceiptId])
  @@map("goods_receipt_items")
}

enum PurchaseInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model PurchaseInvoice {
  id                    String                @id @default(uuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id])
  purchaseOrderId       String
  purchaseOrder         PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  supplierInvoiceNumber String // the supplier's own invoice number, not ours
  invoiceDate           DateTime
  subtotal              Decimal               @db.Decimal(12, 2)
  taxAmount             Decimal               @db.Decimal(12, 2)
  total                 Decimal               @db.Decimal(12, 2)
  status                PurchaseInvoiceStatus @default(UNPAID)
  createdAt             DateTime              @default(now())

  payments SupplierPayment[]

  @@index([tenantId])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, status])
  @@map("purchase_invoices")
}

model SupplierPayment {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  amount            Decimal         @db.Decimal(12, 2)
  paymentDate       DateTime
  method            String
  referenceNumber   String?
  createdAt         DateTime        @default(now())

  @@index([tenantId])
  @@index([tenantId, purchaseInvoiceId])
  @@map("supplier_payments")
}

// Stock deducts when a part is ADDED to a job card (see job-cards.service.ts
// addPart), not deferred to invoicing — Invoicing doesn't exist until Phase
// 7, and physically the part leaves the shelf when it's used, not when the
// paperwork is generated. This is a deliberate deviation from the Phase 1
// doc's literal "Job Card Invoiced -> Inventory Reduced" wording.
model JobCardPart {
  id        String  @id @default(uuid())
  tenantId  String
  jobCardId String
  jobCard   JobCard @relation(fields: [jobCardId], references: [id])
  partId    String
  part      Part    @relation(fields: [partId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  gstRate   Decimal @db.Decimal(5, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  @@index([tenantId, jobCardId])
  @@map("job_card_parts")
}

// ─────────────── BILLING / GST (Phase 7) ───────────────

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

model Invoice {
  id            String @id @default(uuid())
  tenantId      String
  tenant        Tenant @relation(fields: [tenantId], references: [id])
  invoiceNumber String

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // One invoice per job card; nullable for any future non-job-card
  // invoicing (this phase only generates invoices from a job card).
  jobCardId String?  @unique
  jobCard   JobCard? @relation(fields: [jobCardId], references: [id])

  subtotal   Decimal @default(0) @db.Decimal(12, 2)
  cgstAmount Decimal @default(0) @db.Decimal(12, 2)
  sgstAmount Decimal @default(0) @db.Decimal(12, 2)
  igstAmount Decimal @default(0) @db.Decimal(12, 2)
  roundOff   Decimal @default(0) @db.Decimal(12, 2)
  grandTotal Decimal @default(0) @db.Decimal(12, 2)

  status InvoiceStatus @default(UNPAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("invoices")
}

// Snapshotted from JobCardLabour/JobCardPart at generation time — same
// discipline as every other line-item snapshot in this codebase (never a
// live join back to LabourItem/Part pricing). No Tenant relation/back-array
// — nested-only, same reasoning as EstimateLineItem/JobCardLabour.
model InvoiceLineItem {
  id          String  @id @default(uuid())
  tenantId    String
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  gstRate     Decimal @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  @@index([tenantId, invoiceId])
  @@map("invoice_line_items")
}

// Append-only — no update/delete, same discipline as SupplierPayment/
// InventoryTransaction; corrections are new entries, not edits. No Tenant
// relation/back-array either: unlike SupplierPayment (which got its own
// top-level /supplier-payments controller in Phase 6 and so counts as
// "primary" by this schema's own convention), Payment here is reached only
// via POST /invoices/:id/payments — nested-only, so it follows the child-
// table pattern instead.
model Payment {
  id              String   @id @default(uuid())
  tenantId        String
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  amount          Decimal  @db.Decimal(12, 2)
  paymentDate     DateTime @default(now())
  method          String // "cash" | "upi" | "card" | "bank_transfer" | "credit"
  referenceNumber String?
  createdAt       DateTime @default(now())

  @@index([tenantId, invoiceId])
  @@map("payments")
}

// ─────────────── NOTIFICATIONS (Phase 8) ───────────────

// `type` is a plain string, not an enum — this list will keep growing
// ("vehicle_ready", "estimate_approved", …) and a new type shouldn't need
// a migration. `userId` is nullable: null means broadcast, visible to any
// authenticated tenant user (see notifications.service.ts for the
// visibility query, and job-cards.service.ts / estimates.service.ts for
// the two wired triggers' fallback-recipient reasoning). isRead is a
// single flag on the row, not per-user read receipts — a broadcast
// notification marked read by one user reads as read for everyone. That's
// a real, documented simplification for this phase's proof-of-pattern
// scope, not an oversight.
model Notification {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  userId            String?
  user              User?    @relation(fields: [userId], references: [id])
  type              String
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@map("notifications")
}
