// AutoNexa — Phase 2 Prisma schema
// Covers: tenancy, branches, users, roles, permissions, refresh tokens, audit log.
// Later phases append models here (customers, vehicles, job-cards, inventory, billing…)
// following the same tenantId-first indexing convention.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── PLATFORM / TENANCY ─────────────────────────

model Tenant {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  gstin     String?
  planTier  String    @default("standard")
  // Null means no trial — either a permanent/paid plan, or a tenant
  // created before this field existed. Only meaningful when planTier is
  // "trial"; set at provisioning time from CreateTenantDto.trialDays,
  // updatable later via PATCH /tenants/:id/plan when a trial converts.
  trialEndsAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  settings                TenantSettings?
  branches                Branch[]
  users                   User[]
  roles                   Role[]
  auditLogs               AuditLog[]
  customers               Customer[]
  vehicles                Vehicle[]
  appointments            Appointment[]
  inspections             Inspection[]
  estimates               Estimate[]
  labourItems             LabourItem[]
  technicians             Technician[]
  jobCards                JobCard[]
  partCategories          PartCategory[]
  parts                   Part[]
  suppliers               Supplier[]
  purchaseOrders          PurchaseOrder[]
  purchaseInvoices        PurchaseInvoice[]
  supplierPayments        SupplierPayment[]
  invoices                Invoice[]
  notifications           Notification[]
  deliveryLogs            DeliveryLog[]
  attendanceRecords       AttendanceRecord[]
  servicePackages         ServicePackage[]
  customerServicePackages CustomerServicePackage[]
  loyaltyTransactions     LoyaltyTransaction[]
  warrantyClaims          WarrantyClaim[]
  gstExportBatches        GstExportBatch[]

  @@map("tenants")
}

model TenantSettings {
  id                           String   @id @default(uuid())
  tenantId                     String   @unique
  tenant                       Tenant   @relation(fields: [tenantId], references: [id])
  jobCardPrefix                String   @default("JC")
  invoicePrefix                String   @default("INV")
  // How many days after generation an invoice's dueDate lands — see
  // Invoice.dueDate's own doc comment on why the date is frozen at
  // generation time rather than recomputed from this setting later.
  invoicePaymentTermDays       Int      @default(15)
  estimatePrefix               String   @default("EST")
  poPrefix                     String   @default("PO")
  customerPrefix               String   @default("CUST")
  defaultGstRate               Decimal  @default(18) @db.Decimal(5, 2)
  timezone                     String   @default("Asia/Kolkata")
  currency                     String   @default("INR")
  // The workshop's own home state — determines CGST+SGST (same state as
  // the customer) vs IGST (different state) on generated invoices. See
  // calculateGstSplit in modules/invoices/gst-split.ts for the fallback
  // behavior when this (or the customer's own state) is unset.
  state                        String?
  // Set via POST /uploads then PATCH /tenants/me/settings — a relative
  // path like /uploads/<tenantId>/<uuid>.png (see upload-storage.ts), not
  // a bare filename. Printed on this workshop's own exported PDF reports
  // (their branding, not the AutoNexa platform's).
  logoUrl                      String?
  // Same shape/precedent as logoUrl above (set via POST /uploads then
  // PATCH /tenants/me/settings, a raw stored reference, resolved on every
  // read via resolveDisplayUrl). Shown behind the sign-in card on
  // GET /tenants/branding/:slug — the one field that endpoint exposes
  // publicly (pre-auth), since a login screen doesn't know which tenant
  // it's for until the user types the workshop slug.
  loginBackgroundUrl           String?
  // Incoming webhook URL for this workshop's own Slack — internal ops
  // pings only (new appointment, invoice issued, etc.), never customer-facing.
  // Sent via POST to the URL with a plain {"text": "..."} body.
  slackWebhookUrl              String?
  // "HH:mm" 24h, e.g. "09:00"/"19:00" — both null (the default) means the
  // workshop hasn't set business hours, and the dashboard/sidebar simply
  // don't show an Open/Closed indicator at all rather than guessing.
  // Compared against the server's local time via is-workshop-open.ts, same
  // documented "no per-tenant timezone-aware date math" simplification as
  // dashboard.service.ts's todayRange().
  businessHoursOpen            String?
  businessHoursClose           String?
  // Customer-facing reminder cron (see reminder-cron.service.ts) — each
  // type independently toggleable; thresholdDays is shared by all three
  // date-based checks (insurance/PUC expiry, service-due-by-date), each
  // firing once per vehicle per threshold crossing (dedup via
  // DeliveryLog.dedupeKey). serviceIntervalMonths/Km are the tenant-wide
  // default next-service-due rule; Vehicle may override either.
  reminderInsuranceEnabled     Boolean  @default(true)
  reminderPucEnabled           Boolean  @default(true)
  reminderServiceDueEnabled    Boolean  @default(true)
  reminderThresholdDays        Int[]    @default([30, 15, 7])
  serviceIntervalMonths        Int      @default(6)
  serviceIntervalKm            Int      @default(5000)
  // Reuses reminderThresholdDays above — one more date-based check, same
  // threshold/dedup mechanics, no new threshold config needed.
  reminderPackageExpiryEnabled Boolean  @default(true)
  // Loyalty program — master on/off plus the two conversion rates. Both
  // rates apply platform-wide-simple, not tiered/promotional; see the
  // architecture doc for why a flat rate was chosen over a points-tier
  // model for this phase.
  loyaltyEnabled               Boolean  @default(true)
  loyaltyPointsPerRupee        Decimal  @default(0.01) @db.Decimal(6, 4) // 1 point per ₹100 spent (on Invoice.subtotal), by default
  loyaltyPointValueRupees      Decimal  @default(1) @db.Decimal(6, 2) // 1 point = ₹1 of discount, by default
  // Which channel(s) this workshop wants customer-facing notifications
  // sent through — independent of which providers happen to be
  // configured (see MessagingService.notifyCustomer/pickCustomerChannels).
  // All default true so existing tenants keep today's "send on every
  // configured channel" behavior with no migration-time change in
  // observed sending. Internal ops Slack pings are unaffected — this only
  // governs customer-facing EMAIL/SMS/WHATSAPP.
  notifyByEmail                Boolean  @default(true)
  notifyBySms                  Boolean  @default(true)
  notifyByWhatsapp             Boolean  @default(true)
  updatedAt                    DateTime @updatedAt

  @@map("tenant_settings")
}

model Branch {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  address   String?
  city      String?
  phone     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users User[]

  @@index([tenantId])
  @@map("branches")
}

// A per-tenant, per-entity sequence generator for human-readable numbers
// (job card #, invoice #, estimate #) — avoids collisions under concurrency.
model TenantSequence {
  id         String @id @default(uuid())
  tenantId   String
  entityType String // "JOB_CARD" | "INVOICE" | "ESTIMATE" | "PURCHASE_ORDER"
  lastNumber Int    @default(0)

  @@unique([tenantId, entityType])
  @@map("tenant_sequences")
}

// ───────────────────────── IDENTITY & ACCESS ─────────────────────────

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  name         String
  email        String
  passwordHash String
  phone        String?
  // Stored reference (LOCAL_DISK relative path / S3 key) resolved to a
  // display URL via resolveDisplayUrl at every read site — same pattern
  // as Vehicle.photoUrl/TenantSettings.logoUrl. Optional; a user with none
  // falls back to an initials avatar on the frontend.
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  appointmentsAsAdvisor    Appointment[] @relation("AppointmentServiceAdvisor")
  appointmentsAsTechnician Appointment[] @relation("AppointmentTechnician")
  inspectionsAsTechnician  Inspection[]  @relation("InspectionTechnician")

  technician               Technician?
  jobCardsAsServiceAdvisor JobCard[]
  jobCardStatusChanges     JobCardStatusHistory[]
  jobCardNotes             JobCardNote[]

  inventoryTransactions InventoryTransaction[]
  goodsReceiptsReceived GoodsReceipt[]
  notifications         Notification[]

  attendanceRecords       AttendanceRecord[]   @relation("AttendanceOwner")
  attendanceRecordsMarked AttendanceRecord[]   @relation("AttendanceMarkedBy")
  loyaltyAdjustmentsMade  LoyaltyTransaction[]
  warrantyClaimsApproved  WarrantyClaim[]
  gstExportBatches        GstExportBatch[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// Roles are tenant-scoped, except system roles (tenantId = null), e.g. SUPER_ADMIN.
model Role {
  id       String  @id @default(uuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  name     String
  isSystem Boolean @default(false)

  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

// Permissions are global (resource:action pairs); tenants compose roles from them.
model Permission {
  id       String @id @default(uuid())
  resource String // e.g. "job-card", "invoice", "part"
  action   String // e.g. "create", "read", "update", "delete", "cancel"

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id])
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String
  familyId   String // groups rotated tokens; reuse-after-revoke invalidates the family
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ───────────────────────── AUDIT ─────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // e.g. "user.create", "role.assign"
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ───────────────────────── CRM (Phase 3) ─────────────────────────

model Customer {
  id                   String    @id @default(uuid())
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  // Nullable — same reasoning as Estimate.estimateNumber: existing rows
  // can't get a required column without a backfill, and never fabricate
  // one for a pre-numbering customer. Minted via generateSequenceNumber()
  // in CustomersService.create(); scripts/backfill-customer-numbers.ts
  // assigns one to every pre-existing row. Unique per-tenant only (see
  // @@unique below), not globally — two different tenants' sequences
  // both start at 1, so a bare @unique here would collide the moment a
  // second tenant's first customer also became "CUST-0001", same as
  // Invoice.invoiceNumber/JobCard.jobCardNumber's @@unique([tenantId, ...]).
  customerNumber       String?
  name                 String
  mobile               String
  altMobile            String?
  email                String?
  address              String?
  city                 String?
  state                String?
  gstin                String?
  customerType         String    @default("individual") // "individual" | "business"
  notes                String?
  // Opts out of the proactive insurance/PUC/service-due reminder cron only
  // (see reminder-cron.service.ts) — transactional messages (invoice,
  // payment, estimate, appointment) are never gated by this.
  reminderOptOut       Boolean   @default(false)
  // Whether THIS customer wants WhatsApp/SMS at all — distinct from
  // TenantSettings.notifyBySms/notifyByWhatsapp, which control whether the
  // WORKSHOP uses those channels at all. Consulted in
  // MessagingService.notifyCustomer alongside the tenant-wide toggle
  // (both must allow it); Email is never gated by this. Default true so
  // no existing customer's delivery behavior silently changes.
  notifyByWhatsappSms  Boolean   @default(true)
  // Guarded-cache running total, kept in sync with LoyaltyTransaction
  // (the audit-of-record ledger) inside the same transaction on every
  // change — same "mutable cache next to an append-only ledger" pattern
  // as Part.currentStock next to InventoryTransaction. Never write one
  // without the other.
  loyaltyPointsBalance Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  vehicles            Vehicle[]
  appointments        Appointment[]
  estimates           Estimate[]
  jobCards            JobCard[]
  invoices            Invoice[]
  servicePackages     CustomerServicePackage[]
  loyaltyTransactions LoyaltyTransaction[]

  @@unique([tenantId, customerNumber])
  @@index([tenantId])
  @@index([tenantId, mobile])
  @@index([tenantId, name])
  @@map("customers")
}

model Vehicle {
  id                            String    @id @default(uuid())
  tenantId                      String
  tenant                        Tenant    @relation(fields: [tenantId], references: [id])
  customerId                    String
  customer                      Customer  @relation(fields: [customerId], references: [id])
  registrationNo                String
  vin                           String?
  brand                         String
  model                         String
  variant                       String?
  manufactureYear               Int?
  fuelType                      String? // "petrol" | "diesel" | "electric" | "hybrid" | "cng"
  transmission                  String? // "manual" | "automatic"
  colour                        String?
  odometerReading               Int?
  insuranceExpiry               DateTime?
  pucExpiry                     DateTime?
  warrantyInfo                  String?
  purchaseDate                  DateTime?
  notes                         String?
  // Bare /uploads/... path from POST /uploads (see resolveUploadUrl on the
  // frontend) — null means no photo has been uploaded yet, in which case
  // callers show a generic placeholder rather than treating it as an error.
  photoUrl                      String?
  // Null means "use the tenant's default" (TenantSettings.serviceInterval*)
  // — see next-service-due.ts's computeServiceDue.
  serviceIntervalMonthsOverride Int?
  serviceIntervalKmOverride     Int?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  deletedAt                     DateTime?

  documents       VehicleDocument[]
  appointments    Appointment[]
  inspections     Inspection[]
  estimates       Estimate[]
  jobCards        JobCard[]
  servicePackages CustomerServicePackage[]

  @@index([tenantId])
  @@index([tenantId, registrationNo])
  @@index([tenantId, customerId])
  @@index([tenantId, vin])
  @@map("vehicles")
}

// Insurance papers, RC copy, warranty card scans, etc. — metadata only;
// actual bytes live in object storage (see Phase 1 architecture, Section
// "File Storage"). `fileUrl` is a signed/reference URL, not a raw path.
model VehicleDocument {
  id         String   @id @default(uuid())
  tenantId   String
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  docType    String // "insurance" | "rc" | "puc" | "warranty" | "other"
  fileUrl    String
  fileName   String?
  uploadedAt DateTime @default(now())

  @@index([tenantId, vehicleId])
  @@map("vehicle_documents")
}

// ─────────────── FRONT-OF-HOUSE WORKFLOW (Phase 4) ───────────────

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  VEHICLE_RECEIVED
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id])
  vehicleId        String
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id])
  serviceType      String
  appointmentDate  DateTime
  appointmentTime  String
  serviceAdvisorId String?
  serviceAdvisor   User?             @relation("AppointmentServiceAdvisor", fields: [serviceAdvisorId], references: [id])
  technicianId     String?
  technician       User?             @relation("AppointmentTechnician", fields: [technicianId], references: [id])
  notes            String?
  status           AppointmentStatus @default(SCHEDULED)
  // Set by the daily reminder cron (see messaging/reminder-cron.service.ts)
  // once a reminder has gone out, so it isn't re-sent on the next run.
  reminderSentAt   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  inspections Inspection[]

  @@index([tenantId])
  @@index([tenantId, appointmentDate])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, vehicleId])
  @@map("appointments")
}

enum InspectionStatus {
  IN_PROGRESS
  COMPLETED
}

enum InspectionCategory {
  EXTERIOR
  INTERIOR
  MECHANICAL
  ELECTRICAL
  UNDERBODY
}

enum InspectionResult {
  PASS
  FAIL
  NEEDS_ATTENTION
  NOT_CHECKED
}

model Inspection {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  vehicleId     String
  vehicle       Vehicle          @relation(fields: [vehicleId], references: [id])
  appointmentId String?
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id])
  technicianId  String?
  technician    User?            @relation("InspectionTechnician", fields: [technicianId], references: [id])
  status        InspectionStatus @default(IN_PROGRESS)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  // Set once when status transitions to COMPLETED (and cleared if reopened
  // back to IN_PROGRESS) — freezes the duration display at completion time
  // instead of it silently growing on every later re-render. See
  // computeInspectionDurationMinutes() in inspection-display-status.ts.
  completedAt   DateTime?
  // Soft delete, not hard — JobCard.inspectionId can reference this row
  // (see the JobCard model), so removing it must not break that link the
  // way a hard DELETE risking an FK violation (or a silent orphan) would.
  deletedAt     DateTime?

  items    InspectionItem[]
  photos   InspectionPhoto[]
  jobCards JobCard[]

  @@index([tenantId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, appointmentId])
  @@map("inspections")
}

// Exterior/Interior/Mechanical checklist rows (Phase 1, Section 9). Created
// in bulk from a default-per-category constant when an inspection starts
// (see default-inspection-checklist.ts); ad-hoc items can still be added.
model InspectionItem {
  id           String             @id @default(uuid())
  tenantId     String
  inspectionId String
  inspection   Inspection         @relation(fields: [inspectionId], references: [id])
  category     InspectionCategory
  itemName     String
  result       InspectionResult   @default(NOT_CHECKED)
  remarks      String?

  @@index([tenantId, inspectionId])
  @@map("inspection_items")
}

// Metadata-only, same pattern as VehicleDocument — actual bytes live in
// object storage per the Phase 1 "File Storage" module.
model InspectionPhoto {
  id           String     @id @default(uuid())
  tenantId     String
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id])
  fileUrl      String
  fileName     String?
  uploadedAt   DateTime   @default(now())

  @@index([tenantId, inspectionId])
  @@map("inspection_photos")
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

model Estimate {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  vehicleId      String
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id])
  // Nullable — Postgres can't add a required column to a table with
  // existing rows without a backfill, and a genuinely pre-numbering
  // estimate should show as such rather than getting a fabricated number.
  // Minted via generateSequenceNumber() in EstimatesService.create();
  // scripts/backfill-estimate-numbers.ts assigns one to every pre-existing
  // row, continuing the same per-tenant TenantSequence counter so newly
  // created estimates never collide with a backfilled one. Unique
  // per-tenant only (see @@unique below), not globally — matches
  // Invoice.invoiceNumber/JobCard.jobCardNumber's @@unique([tenantId, ...]);
  // a bare @unique here collided the first time a second tenant's first
  // estimate also became "EST-0001".
  estimateNumber String?
  jobDescription String?
  status         EstimateStatus @default(DRAFT)
  subtotal       Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2)
  discountAmount Decimal        @default(0) @db.Decimal(12, 2)
  total          Decimal        @default(0) @db.Decimal(12, 2)
  approvedAt     DateTime?
  rejectedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  lineItems      EstimateLineItem[]
  jobCard        JobCard?
  approvalEvents EstimateApprovalEvent[]

  @@unique([tenantId, estimateNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, vehicleId])
  @@map("estimates")
}

// Append-only audit trail for the customer self-approval link — same
// "written, never updated/deleted" discipline as JobCardStatusHistory/
// JobCardNote/InventoryTransaction/PaymentGatewayEvent. Unlike
// PaymentGatewayEvent, tenantId here is NOT nullable: the customer
// approval token is a JWT AutoNexa itself signs, so by the time any row is
// written the token has already verified and tenantId is a trusted claim
// — no unscoped lookup needed to discover it (see the architecture doc
// §3.1). The two failure cases where a token never verifies at all
// (TOKEN_EXPIRED/TOKEN_INVALID) are the one exception — see
// estimate-approval.service.ts.
model EstimateApprovalEvent {
  id         String    @id @default(uuid())
  tenantId   String?
  estimateId String?
  estimate   Estimate? @relation(fields: [estimateId], references: [id])
  action     String // "VIEWED" | "APPROVED" | "REJECTED" | "TOKEN_EXPIRED" | "TOKEN_INVALID" | "ALREADY_DECIDED"
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([tenantId, estimateId])
  @@map("estimate_approval_events")
}

enum EstimateLineItemType {
  LABOUR
  PART
  CONSUMABLE
}

// lineTotal is quantity × unitPrice (pre-tax); GST is aggregated onto the
// parent Estimate's taxAmount, not stored per line — see estimate-totals.ts.
// Recalculated server-side on every line-item add/update/remove, never
// trusted from the client.
model EstimateLineItem {
  id          String               @id @default(uuid())
  tenantId    String
  estimateId  String
  estimate    Estimate             @relation(fields: [estimateId], references: [id])
  itemType    EstimateLineItemType
  description String
  quantity    Decimal              @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal              @db.Decimal(12, 2)
  gstRate     Decimal              @default(18) @db.Decimal(5, 2)
  lineTotal   Decimal              @db.Decimal(12, 2)

  @@index([tenantId, estimateId])
  @@map("estimate_line_items")
}

// ─────────────── OPERATIONAL CORE (Phase 5) ───────────────

model LabourItem {
  id                   String    @id @default(uuid())
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  code                 String
  description          String
  standardHours        Decimal   @db.Decimal(6, 2)
  labourRate           Decimal   @db.Decimal(10, 2)
  gstRate              Decimal   @default(18) @db.Decimal(5, 2)
  sacCode              String? // GST Services Accounting Code — printed per line item on invoices (see JobCardLabour.hsnSac/InvoiceLineItem.hsnSac)
  technicianCategory   String?
  // Default workshop-repair-warranty term for this labour item — null
  // means no warranty offered. Snapshotted onto JobCardLabour.warrantyMonths
  // at add-labour time, same discipline as labourRate/gstRate above; a
  // later edit here never retroactively changes a job already performed.
  // No km-based counterpart (unlike Part) — a labour warranty isn't
  // naturally mileage-bound the way a part's wear life is.
  warrantyPeriodMonths Int?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  jobCardLabours           JobCardLabour[]
  servicePackageInclusions ServicePackageLabourItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("labour_items")
}

enum TechnicianStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

// A technician IS a User with the Technician role — this table is their
// operational profile (skills, workload), not a separate identity. No
// deletedAt: deactivation goes through `status` (INACTIVE), not soft delete.
model Technician {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id])
  employeeId      String?
  skills          String[]
  specialisation  String?
  experienceYears Int?
  status          TechnicianStatus @default(ACTIVE)
  // Denominator for the derived workload% shown on the list/board (see
  // technician-workload.ts) — a real per-technician setting, not a
  // hardcoded constant, since a senior tech may reasonably carry more
  // concurrent jobs than a junior one.
  maxConcurrentJobs Int            @default(4)
  // Scheduling metadata only — nothing in this app currently reads these
  // to gate appointment/job-card assignment; they exist so the profile
  // can genuinely persist what the New/Edit Technician form collects.
  workingDays        String[]      @default(["MON", "TUE", "WED", "THU", "FRI", "SAT"])
  workingHoursStart  String?
  workingHoursEnd    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  jobCards JobCard[]

  @@index([tenantId])
  @@map("technicians")
}

enum JobCardStatus {
  OPEN
  DIAGNOSIS
  WAITING_APPROVAL
  APPROVED
  IN_PROGRESS
  WAITING_PARTS
  QUALITY_CHECK
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum JobCardPriority {
  NORMAL
  HIGH
  URGENT
}

model JobCard {
  id            String @id @default(uuid())
  tenantId      String
  tenant        Tenant @relation(fields: [tenantId], references: [id])
  jobCardNumber String

  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  // Denormalized from vehicle.customerId for query convenience — same
  // pattern as Appointment.
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Optional: walk-ins skip estimates entirely.
  estimateId String?   @unique
  estimate   Estimate? @relation(fields: [estimateId], references: [id])

  inspectionId String?
  inspection   Inspection? @relation(fields: [inspectionId], references: [id])

  technicianId String?
  technician   Technician? @relation(fields: [technicianId], references: [id])

  serviceAdvisorId String?
  serviceAdvisor   User?   @relation(fields: [serviceAdvisorId], references: [id])

  // Set when this visit redeems against an active AMC/service package —
  // see AMC-loyalty-architecture notes on JobCardLabour/JobCardPart: those
  // two models gain NO new columns, coverage is derived at read/invoice
  // time by joining through here to the package's included-items lists,
  // not stored per-line (a stored flag could go stale if the link changed;
  // deriving fresh can't). The visit-used counter on
  // CustomerServicePackage increments once, on this job card's DELIVERED
  // transition, not per line added.
  redeemedPackageId String?
  redeemedPackage   CustomerServicePackage? @relation(fields: [redeemedPackageId], references: [id])

  odometer        Int?
  complaint       String?
  customerRequest String?
  estimatedWork   String?

  status           JobCardStatus   @default(OPEN)
  priority         JobCardPriority @default(NORMAL)
  startAt          DateTime?
  expectedDelivery DateTime?
  actualDelivery   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  labourItems    JobCardLabour[]
  statusHistory  JobCardStatusHistory[]
  notes          JobCardNote[]
  parts          JobCardPart[]
  invoice        Invoice?
  // Claims raised in the context of THIS job card (the comeback visit) —
  // not the claims against lines originally performed on this job card
  // (that's JobCardLabour/JobCardPart.originalOfClaims instead). No new
  // JobCardStatus values and no isWarrantyClaim flag — whether this job
  // card is "a warranty claim visit" is simply whether this list is
  // non-empty, derived, never stored.
  warrantyClaims WarrantyClaim[]        @relation("WarrantyClaimJobCard")

  @@unique([tenantId, jobCardNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, vehicleId])
  @@index([tenantId, customerId])
  @@index([tenantId, technicianId])
  @@index([tenantId, redeemedPackageId])
  @@map("job_cards")
}

// labourItemId is nullable, not strictly required: Estimate -> Job Card
// conversion (job-cards.service.ts createFromEstimate) looks up a matching
// LabourItem by description for categorization/reporting only — rate and
// gstRate always come from the estimate line's own approved unitPrice/
// gstRate, never from the catalogue match, since that's the price the
// customer actually approved (approved-price integrity, not live catalogue
// pricing). No match still means no labourItemId rather than fabricating a
// synthetic LabourItem row. POST /job-cards/:id/labour, the direct-add
// endpoint with no estimate behind it, uses live catalogue pricing and
// still requires labourItemId via its DTO.
model JobCardLabour {
  id               String          @id @default(uuid())
  tenantId         String
  jobCardId        String
  jobCard          JobCard         @relation(fields: [jobCardId], references: [id])
  labourItemId     String?
  labourItem       LabourItem?     @relation(fields: [labourItemId], references: [id])
  description      String?
  hours            Decimal         @db.Decimal(6, 2)
  rate             Decimal         @db.Decimal(10, 2)
  gstRate          Decimal         @db.Decimal(5, 2)
  hsnSac           String? // snapshotted from LabourItem.sacCode at add-labour/convert time, same discipline as gstRate above
  lineTotal        Decimal         @db.Decimal(12, 2)
  // Snapshotted from LabourItem.warrantyPeriodMonths at add time — null
  // means no warranty was offered on this line. Expiry is never stored;
  // computed on read from JobCard.actualDelivery + this, see
  // warranty-status.ts's computeWarrantyExpiry.
  warrantyMonths   Int?
  // Set when this line IS the fix for an open warranty claim raised
  // against a prior line — see WarrantyClaim's doc comment. Null for the
  // overwhelming majority of ordinary billable lines.
  warrantyClaimId  String?
  warrantyClaim    WarrantyClaim?  @relation("ClaimCoveredLabour", fields: [warrantyClaimId], references: [id])
  // The other side of WarrantyClaim.originalJobCardLabourId — onDelete:
  // Restrict there means Postgres blocks deleting this row once a claim
  // references it as the ORIGINAL defective line (separate from the
  // warrantyClaimId above, which marks this row as a CLAIM'S FIX, not
  // its target).
  originalOfClaims WarrantyClaim[] @relation("ClaimOriginalLabour")

  @@index([tenantId, jobCardId])
  @@index([tenantId, warrantyClaimId])
  @@map("job_card_labour")
}

// Append-only domain timeline (shown on the job card's UI timeline), not
// just a compliance log like AuditLog — no updatedAt/deletedAt, rows are
// never edited or removed.
model JobCardStatusHistory {
  id              String         @id @default(uuid())
  tenantId        String
  jobCardId       String
  jobCard         JobCard        @relation(fields: [jobCardId], references: [id])
  fromStatus      JobCardStatus?
  toStatus        JobCardStatus
  changedByUserId String?
  changedByUser   User?          @relation(fields: [changedByUserId], references: [id])
  changedAt       DateTime       @default(now())
  notes           String?

  @@index([tenantId, jobCardId])
  @@map("job_card_status_history")
}

model JobCardNote {
  id        String   @id @default(uuid())
  tenantId  String
  jobCardId String
  jobCard   JobCard  @relation(fields: [jobCardId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  note      String
  createdAt DateTime @default(now())

  @@index([tenantId, jobCardId])
  @@map("job_card_notes")
}

// ─────────────── PARTS & INVENTORY (Phase 6) ───────────────

model PartCategory {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  deletedAt DateTime?

  parts                    Part[]
  servicePackageInclusions ServicePackagePartCategory[]

  @@index([tenantId])
  @@map("part_categories")
}

model Part {
  id                   String        @id @default(uuid())
  tenantId             String
  tenant               Tenant        @relation(fields: [tenantId], references: [id])
  partNumber           String
  sku                  String
  name                 String
  categoryId           String?
  category             PartCategory? @relation(fields: [categoryId], references: [id])
  brand                String?
  vehicleCompatibility String? // freeform for now
  supplierId           String? // primary/preferred supplier
  supplier             Supplier?     @relation(fields: [supplierId], references: [id])
  purchasePrice        Decimal       @db.Decimal(12, 2)
  sellingPrice         Decimal       @db.Decimal(12, 2)
  gstRate              Decimal       @default(18) @db.Decimal(5, 2)
  hsnCode              String? // GST HSN code for goods — printed per line item on invoices (see JobCardPart.hsnSac/InvoiceLineItem.hsnSac)
  currentStock         Int           @default(0)
  minStock             Int           @default(0)
  maxStock             Int?
  binLocation          String?
  // Default workshop-repair-warranty term for this part — null means no
  // warranty offered. Snapshotted onto JobCardPart.warrantyMonths/
  // warrantyKm at add-part time, same discipline as sellingPrice/gstRate;
  // a later edit here never retroactively changes a job already done.
  // Was previously declared but never actually read anywhere — this
  // phase is the first to snapshot/use it.
  warrantyPeriodMonths Int?
  // Whichever comes first — same "months or km" shape as
  // TenantSettings.serviceIntervalMonths/Km.
  warrantyKm           Int?
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  transactions             InventoryTransaction[]
  purchaseOrderItems       PurchaseOrderItem[]
  jobCardParts             JobCardPart[]
  servicePackageInclusions ServicePackagePart[]

  @@unique([tenantId, partNumber])
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, supplierId])
  @@map("parts")
}

enum InventoryTxnType {
  PURCHASE_IN
  JOB_CARD_CONSUMPTION
  SALE
  RETURN
  ADJUSTMENT
  DAMAGED
  TRANSFER
}

// Append-only ledger, same spirit as JobCardStatusHistory — no update or
// delete. `quantity` is signed (positive = stock in, negative = stock out),
// so Part.currentStock is always re-derivable as the sum of this table for
// that part; currentStock itself is a denormalized running total kept in
// sync by every mutation, not the source of truth.
model InventoryTransaction {
  id          String           @id @default(uuid())
  tenantId    String
  partId      String
  part        Part             @relation(fields: [partId], references: [id])
  type        InventoryTxnType
  quantity    Int
  refType     String? // "JobCard" | "PurchaseOrder" | "Adjustment"
  refId       String?
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id])
  notes       String?
  createdAt   DateTime         @default(now())

  @@index([tenantId, partId])
  @@index([tenantId, createdAt])
  @@map("inventory_transactions")
}

model Supplier {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  name          String
  contactPerson String?
  mobile        String?
  email         String?
  address       String?
  gstin         String?
  paymentTerms  String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  parts          Part[]
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// No deletedAt — CANCELLED is the terminal/withdrawn state, same pattern as
// JobCard's own CANCELLED status.
model PurchaseOrder {
  id                   String              @id @default(uuid())
  tenantId             String
  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  poNumber             String
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  status               PurchaseOrderStatus @default(DRAFT)
  expectedDeliveryDate DateTime?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  items            PurchaseOrderItem[]
  goodsReceipts    GoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  tenantId         String
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  partId           String
  part             Part          @relation(fields: [partId], references: [id])
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Decimal       @db.Decimal(12, 2)
  gstRate          Decimal       @db.Decimal(5, 2)
  lineTotal        Decimal       @db.Decimal(12, 2)

  goodsReceiptItems GoodsReceiptItem[]

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  tenantId        String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedById    String?
  receivedBy      User?         @relation(fields: [receivedById], references: [id])
  receivedAt      DateTime      @default(now())
  notes           String?

  items GoodsReceiptItem[]

  @@index([tenantId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String            @id @default(uuid())
  tenantId            String
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id])
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  quantityReceived    Int

  @@index([tenantId, goodsReceiptId])
  @@map("goods_receipt_items")
}

enum PurchaseInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model PurchaseInvoice {
  id                    String                @id @default(uuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id])
  purchaseOrderId       String
  purchaseOrder         PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  supplierInvoiceNumber String // the supplier's own invoice number, not ours
  invoiceDate           DateTime
  subtotal              Decimal               @db.Decimal(12, 2)
  taxAmount             Decimal               @db.Decimal(12, 2)
  total                 Decimal               @db.Decimal(12, 2)
  status                PurchaseInvoiceStatus @default(UNPAID)
  createdAt             DateTime              @default(now())

  payments SupplierPayment[]

  @@index([tenantId])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, status])
  @@map("purchase_invoices")
}

model SupplierPayment {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  amount            Decimal         @db.Decimal(12, 2)
  paymentDate       DateTime
  method            String
  referenceNumber   String?
  createdAt         DateTime        @default(now())

  @@index([tenantId])
  @@index([tenantId, purchaseInvoiceId])
  @@map("supplier_payments")
}

// Stock deducts when a part is ADDED to a job card (see job-cards.service.ts
// addPart), not deferred to invoicing — Invoicing doesn't exist until Phase
// 7, and physically the part leaves the shelf when it's used, not when the
// paperwork is generated. This is a deliberate deviation from the Phase 1
// doc's literal "Job Card Invoiced -> Inventory Reduced" wording.
model JobCardPart {
  id               String          @id @default(uuid())
  tenantId         String
  jobCardId        String
  jobCard          JobCard         @relation(fields: [jobCardId], references: [id])
  partId           String
  part             Part            @relation(fields: [partId], references: [id])
  quantity         Int
  unitPrice        Decimal         @db.Decimal(12, 2)
  gstRate          Decimal         @db.Decimal(5, 2)
  hsnSac           String? // snapshotted from Part.hsnCode at add-part time, same discipline as gstRate above
  lineTotal        Decimal         @db.Decimal(12, 2)
  // Snapshotted from Part.warrantyPeriodMonths/warrantyKm at add time —
  // both null means no warranty was offered on this line. Expiry is
  // never stored; computed on read, see warranty-status.ts.
  warrantyMonths   Int?
  warrantyKm       Int?
  // Set when this line IS the fix for an open warranty claim — see
  // JobCardLabour.warrantyClaimId's identical doc comment.
  warrantyClaimId  String?
  warrantyClaim    WarrantyClaim?  @relation("ClaimCoveredParts", fields: [warrantyClaimId], references: [id])
  originalOfClaims WarrantyClaim[] @relation("ClaimOriginalPart")

  @@index([tenantId, jobCardId])
  @@index([tenantId, warrantyClaimId])
  @@map("job_card_parts")
}

// ─────────────── BILLING / GST (Phase 7) ───────────────

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

model Invoice {
  id            String @id @default(uuid())
  tenantId      String
  tenant        Tenant @relation(fields: [tenantId], references: [id])
  invoiceNumber String

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // One invoice per job card; nullable for any future non-job-card
  // invoicing (this phase only generates invoices from a job card).
  jobCardId String?  @unique
  jobCard   JobCard? @relation(fields: [jobCardId], references: [id])

  subtotal   Decimal @default(0) @db.Decimal(12, 2)
  cgstAmount Decimal @default(0) @db.Decimal(12, 2)
  sgstAmount Decimal @default(0) @db.Decimal(12, 2)
  igstAmount Decimal @default(0) @db.Decimal(12, 2)
  roundOff   Decimal @default(0) @db.Decimal(12, 2)
  grandTotal Decimal @default(0) @db.Decimal(12, 2)

  // Loyalty-points redemption applied to this invoice, if any — informational/
  // audit fields; the actual pre-tax proration already happened before
  // subtotal/GST above were computed (see discount.ts's applyProRataDiscount).
  // The LoyaltyTransaction row (type REDEEMED) linked via invoiceId is the
  // ledger entry of record; these two columns just make it visible on the
  // invoice itself without a join.
  loyaltyPointsRedeemed Int     @default(0)
  loyaltyDiscountAmount Decimal @default(0) @db.Decimal(12, 2)

  status InvoiceStatus @default(UNPAID)
  // Set once at generation from TenantSettings.invoicePaymentTermDays —
  // never recomputed afterward, so a later change to the tenant's term
  // setting doesn't retroactively shift an already-issued invoice's due
  // date. "Overdue" itself is derived from this (see invoice-overdue.ts),
  // never stored.
  dueDate DateTime?

  // Set when a Razorpay Payment Link is generated for this invoice, cleared
  // once the link resolves (paid/expired/cancelled) — see the payment
  // gateway architecture doc §3.2/§4.1. This is the ONLY link between a
  // pending gateway order and its tenant: a webhook arrives with no tenant
  // context at all, so the webhook handler resolves tenantId by looking
  // this field up via the unscoped `prisma.platform` client (same "no
  // request context" precedent as ReminderCronService/MessagingService.log),
  // then explicitly enters TenantContext.run() before touching anything
  // else. No Payment row exists yet at this point — see Payment's own
  // gateway fields below for why.
  pendingGatewayOrderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems           InvoiceLineItem[]
  payments            Payment[]
  soldPackage         CustomerServicePackage?
  loyaltyTransactions LoyaltyTransaction[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([pendingGatewayOrderId])
  @@map("invoices")
}

// Snapshotted from JobCardLabour/JobCardPart at generation time — same
// discipline as every other line-item snapshot in this codebase (never a
// live join back to LabourItem/Part pricing). No Tenant relation/back-array
// — nested-only, same reasoning as EstimateLineItem/JobCardLabour.
model InvoiceLineItem {
  id          String  @id @default(uuid())
  tenantId    String
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  gstRate     Decimal @db.Decimal(5, 2)
  hsnSac      String? // final snapshot, carried from JobCardPart.hsnSac/JobCardLabour.hsnSac — printed per line on the GST invoice
  lineTotal   Decimal @db.Decimal(12, 2)

  @@index([tenantId, invoiceId])
  @@map("invoice_line_items")
}

// Append-only — no update/delete, same discipline as SupplierPayment/
// InventoryTransaction; corrections are new entries, not edits. No Tenant
// relation/back-array either: unlike SupplierPayment (which got its own
// top-level /supplier-payments controller in Phase 6 and so counts as
// "primary" by this schema's own convention), Payment here is reached only
// via POST /invoices/:id/payments — nested-only, so it follows the child-
// table pattern instead.
model Payment {
  id              String   @id @default(uuid())
  tenantId        String
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  amount          Decimal  @db.Decimal(12, 2)
  paymentDate     DateTime @default(now())
  method          String // "cash" | "upi" | "card" | "bank_transfer" | "credit" | "razorpay"
  referenceNumber String?
  createdAt       DateTime @default(now())

  // Gateway fields — all null for a manual payment (the only path today;
  // unchanged). Populated only when method = "razorpay". A Payment row for
  // a gateway transaction is only ever created once Razorpay confirms
  // `payment.captured` — never at Payment Link creation time — so every
  // row here, gateway or manual, already represents money that actually
  // arrived. That's deliberate: it means InvoicesService.recalculateStatus()
  // (which sums every Payment row unconditionally) needs no changes at all
  // to support this feature. See the payment gateway architecture doc §2.2.
  provider          String? // "razorpay" — free string like `method`, not an enum, so a second provider later needs no migration
  providerOrderId   String? // Razorpay Order id ("order_...")
  providerPaymentId String? // Razorpay Payment id ("pay_..."), set once captured
  providerSignature String? // The signature Razorpay sent on this event — kept for audit/dispute reference, never re-verified from storage

  @@index([tenantId, invoiceId])
  @@index([providerOrderId])
  @@map("payments")
}

// Raw webhook audit trail for the payment gateway — every delivery
// Razorpay makes, verified or not, processed or not. Deliberately NOT in
// TENANT_SCOPED_MODELS (prisma.service.ts): a webhook has no tenant
// context until the handler resolves one mid-request (via
// Invoice.pendingGatewayOrderId above), so this is always written through
// the unscoped `prisma.platform` client, same as ReminderCronService.
// `tenantId` is genuinely nullable here — unlike every other table in
// TENANT_SCOPED_MODELS — because a signature failure or an event for an
// unrecognized order never learns a tenant at all.
model PaymentGatewayEvent {
  id              String    @id @default(uuid())
  tenantId        String?
  provider        String    @default("razorpay")
  eventId         String // Razorpay's own event id — the idempotency key (Razorpay retries webhook delivery)
  eventType       String // "payment.captured" | "payment.failed" | "payment_link.expired" | "payment_link.cancelled" | ...
  providerOrderId String?
  signatureValid  Boolean
  processedAt     DateTime? // null = received but not (yet, or ever) applied — see processingError
  processingError String?
  rawPayload      Json
  createdAt       DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([tenantId, createdAt])
  @@index([providerOrderId])
  @@map("payment_gateway_events")
}

// ─────────────── NOTIFICATIONS (Phase 8) ───────────────

// `type` is a plain string, not an enum — this list will keep growing
// ("vehicle_ready", "estimate_approved", …) and a new type shouldn't need
// a migration. `userId` is nullable: null means broadcast, visible to any
// authenticated tenant user (see notifications.service.ts for the
// visibility query, and job-cards.service.ts / estimates.service.ts for
// the two wired triggers' fallback-recipient reasoning). isRead is a
// single flag on the row, not per-user read receipts — a broadcast
// notification marked read by one user reads as read for everyone. That's
// a real, documented simplification for this phase's proof-of-pattern
// scope, not an oversight.
model Notification {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  userId            String?
  user              User?    @relation(fields: [userId], references: [id])
  type              String
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

// ─────────────── OUTBOUND MESSAGING (Phase 9) ───────────────
// Distinct from Notification above: that model is the in-app staff bell
// (broadcast/personal, read/unread). DeliveryLog tracks actual outbound
// sends to external channels — customer-facing (Email/SMS/WhatsApp) and
// workshop-ops-facing (Slack) — one row per attempted send, so a
// misconfigured or unreachable provider is visible rather than silent.

enum DeliveryChannel {
  EMAIL
  SMS
  WHATSAPP
  SLACK
}

enum DeliveryStatus {
  SENT
  FAILED
  // Provider not configured (no env credentials) or no usable recipient
  // (e.g. customer has no email) — not an error, a known no-op.
  SKIPPED
}

model DeliveryLog {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  channel           DeliveryChannel
  // e.g. "appointment.confirmed", "estimate.ready", "job-card.ready",
  // "invoice.issued", "payment.received" — free-form like Notification.type,
  // deliberately not an enum for the same reason (this list will grow).
  event             String
  recipient         String
  status            DeliveryStatus
  errorMessage      String?
  relatedEntityType String?
  relatedEntityId   String?
  // Recurring/threshold-based reminders only (reminder-cron.service.ts) —
  // e.g. "<vehicleId>:insuranceExpiry:2027-03-15:30d" or
  // "<vehicleId>:odometer:48000". Existence of a row with this exact key
  // means that specific threshold crossing has already been messaged, so
  // it won't repeat — but a NEW expiry date (renewal) or a new last-service
  // odometer produces a new key, letting the cycle fire again. Null for
  // every other event type (appointment/estimate/invoice/payment), which
  // don't need this since they're one-shot, not recurring.
  dedupeKey         String?
  createdAt         DateTime        @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, event, dedupeKey])
  @@map("delivery_logs")
}

// ─────────────── EMPLOYEE ATTENDANCE (Phase 10) ───────────────
// Every login account (User), not just Technicians — a Receptionist or
// Accountant clocks in the same way a Technician does. One record per
// (user, calendar day): self clock-in/out is the everyday path (no
// permission gate, like changeOwnPassword — see attendance.controller.ts),
// and Owner/Manager can additionally create/correct any user's record for
// forgotten clock-ins or manual register-style marking.

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  userId         String
  user           User             @relation("AttendanceOwner", fields: [userId], references: [id])
  date           DateTime         @db.Date
  status         AttendanceStatus @default(PRESENT)
  checkInAt      DateTime?
  checkOutAt     DateTime?
  notes          String?
  // Null when self-marked via clock-in/out; set to the admin's user id when
  // created/corrected through the admin endpoints — lets the UI show "marked
  // by Demo Owner" instead of implying the employee entered it themselves.
  markedByUserId String?
  markedBy       User?            @relation("AttendanceMarkedBy", fields: [markedByUserId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([tenantId, userId, date])
  @@index([tenantId, date])
  @@index([tenantId, userId])
  @@map("attendance_records")
}

// ─────────────── AMC / SERVICE PACKAGES + LOYALTY (Phase 11) ───────────────
// ServicePackage is the tenant-defined template (catalogue item);
// CustomerServicePackage is one specific sale of it to one customer+
// vehicle. A JobCard redeems against an active CustomerServicePackage via
// JobCard.redeemedPackageId — JobCardLabour/JobCardPart deliberately gain
// NO new columns: whether a given line is package-covered is derived at
// read/invoice time by joining through to these three inclusion lists,
// not stored per-line (see JobCard.redeemedPackageId's doc comment).

model ServicePackage {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  name           String
  description    String?
  price          Decimal   @db.Decimal(12, 2)
  gstRate        Decimal   @db.Decimal(5, 2)
  validityMonths Int
  // null = unlimited visits within the validity window.
  visitLimit     Int?
  // Retiring a template (stop selling it) without deleting it — sold
  // CustomerServicePackage rows reference it forever for display, same
  // reasoning as Part.isActive/LabourItem.isActive.
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  includedLabourItems    ServicePackageLabourItem[]
  includedParts          ServicePackagePart[]
  includedPartCategories ServicePackagePartCategory[]
  soldPackages           CustomerServicePackage[]

  @@index([tenantId])
  @@map("service_packages")
}

// Three small many-to-many join tables, same shape as RolePermission —
// together they define exactly what redeeming this package covers for free.
model ServicePackageLabourItem {
  id               String         @id @default(uuid())
  tenantId         String
  servicePackageId String
  servicePackage   ServicePackage @relation(fields: [servicePackageId], references: [id])
  labourItemId     String
  labourItem       LabourItem     @relation(fields: [labourItemId], references: [id])

  @@unique([servicePackageId, labourItemId])
  @@map("service_package_labour_items")
}

model ServicePackagePart {
  id               String         @id @default(uuid())
  tenantId         String
  servicePackageId String
  servicePackage   ServicePackage @relation(fields: [servicePackageId], references: [id])
  partId           String
  part             Part           @relation(fields: [partId], references: [id])

  @@unique([servicePackageId, partId])
  @@map("service_package_parts")
}

model ServicePackagePartCategory {
  id               String         @id @default(uuid())
  tenantId         String
  servicePackageId String
  servicePackage   ServicePackage @relation(fields: [servicePackageId], references: [id])
  partCategoryId   String
  partCategory     PartCategory   @relation(fields: [partCategoryId], references: [id])

  @@unique([servicePackageId, partCategoryId])
  @@map("service_package_part_categories")
}

enum CustomerPackageStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model CustomerServicePackage {
  id               String         @id @default(uuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  servicePackageId String
  servicePackage   ServicePackage @relation(fields: [servicePackageId], references: [id])
  customerId       String
  customer         Customer       @relation(fields: [customerId], references: [id])
  vehicleId        String
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id])

  // The standalone (jobCardId: null) invoice that recorded this sale —
  // price/GST live there as an InvoiceLineItem, not duplicated here.
  purchaseInvoiceId String  @unique
  purchaseInvoice   Invoice @relation(fields: [purchaseInvoiceId], references: [id])

  startDate  DateTime              @default(now())
  // = startDate + ServicePackage.validityMonths, computed once at purchase.
  endDate    DateTime
  // SNAPSHOTTED from ServicePackage.visitLimit at purchase time — a later
  // template edit must not retroactively change a sold package's terms,
  // same snapshot-pricing discipline as every other line-item field in
  // this codebase.
  visitLimit Int?
  visitsUsed Int                   @default(0)
  status     CustomerPackageStatus @default(ACTIVE)

  // Renewal chain — a renewal is a new row (new sale, new invoice), linked
  // back for continuity/reporting, not a mutation of the expiring one.
  renewedFromId String?                 @unique
  renewedFrom   CustomerServicePackage? @relation("PackageRenewal", fields: [renewedFromId], references: [id])
  renewedTo     CustomerServicePackage? @relation("PackageRenewal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Every job card that redeemed a visit against this package — this IS
  // the redemption audit trail; no separate log table needed.
  jobCards JobCard[]

  @@index([tenantId, customerId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, status, endDate])
  @@map("customer_service_packages")
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  ADJUSTED
}

// Append-only ledger — the source of truth for audit/reporting, paired
// with Customer.loyaltyPointsBalance (a guarded-cache running total kept
// in sync inside the same transaction as every insert here). Same
// "mutable cache next to an append-only ledger" pattern as
// Part.currentStock next to InventoryTransaction.
model LoyaltyTransaction {
  id               String                 @id @default(uuid())
  tenantId         String
  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  customerId       String
  customer         Customer               @relation(fields: [customerId], references: [id])
  // The invoice that earned/redeemed these points — null only for a
  // manual ADJUSTED correction (goodwill points, error fix, ...).
  invoiceId        String?
  invoice          Invoice?               @relation(fields: [invoiceId], references: [id])
  type             LoyaltyTransactionType
  // Positive for EARNED/upward ADJUSTED, negative for REDEEMED/downward ADJUSTED.
  points           Int
  // Snapshot of Customer.loyaltyPointsBalance immediately after this entry
  // — lets "what was the balance at time X" be read directly off the
  // ledger row without re-summing history.
  balanceAfter     Int
  // Effectively required for ADJUSTED; self-explanatory via invoiceId for
  // EARNED/REDEEMED.
  note             String?
  // Who made a manual correction — same spirit as
  // JobCardStatusHistory.changedByUserId. Null for EARNED/REDEEMED.
  adjustedByUserId String?
  adjustedByUser   User?                  @relation(fields: [adjustedByUserId], references: [id])
  createdAt        DateTime               @default(now())

  @@index([tenantId, customerId, createdAt])
  @@map("loyalty_transactions")
}

// ─────────────── WARRANTY TRACKING & COMEBACK CLAIMS (Phase 12) ───────────────
// JobCard.status/job-card-status-transitions.ts are completely untouched —
// a warranty-claim visit is an ordinary job card; whether it "is" one is
// simply whether warrantyClaims (below) is non-empty, never a stored flag.

enum WarrantyClaimStatus {
  OPEN
  APPROVED
  REJECTED
  RESOLVED
}

model WarrantyClaim {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // The NEW job card where the comeback repair happens.
  claimJobCardId String
  claimJobCard   JobCard @relation("WarrantyClaimJobCard", fields: [claimJobCardId], references: [id])

  // Exactly one of these two is set (app-validated, not a DB constraint —
  // consistent with this codebase never using raw-SQL CHECK constraints).
  // onDelete: Restrict on both — once a claim references an original
  // line, that line can no longer be hard-deleted via
  // removeLabour/removePart; it's now evidence.
  originalJobCardPartId   String?
  originalJobCardPart     JobCardPart?   @relation("ClaimOriginalPart", fields: [originalJobCardPartId], references: [id], onDelete: Restrict)
  originalJobCardLabourId String?
  originalJobCardLabour   JobCardLabour? @relation("ClaimOriginalLabour", fields: [originalJobCardLabourId], references: [id], onDelete: Restrict)

  status           WarrantyClaimStatus @default(OPEN)
  // Locked in at approval, not derived from status alone — a manager
  // could approve a claim as a partial-goodwill gesture that's still
  // partly billed. Defaults to true (billable) until a manager says
  // otherwise, so nothing is given away for free before sign-off.
  isBillable       Boolean             @default(true)
  resolutionNotes  String?
  approvedByUserId String?
  approvedByUser   User?               @relation(fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // The new line(s) added to the claim job card that ARE the fix — tagged
  // manually by staff, not derived (unlike AMC package coverage, there's
  // no template to match a comeback fix against).
  coveredLabourLines JobCardLabour[] @relation("ClaimCoveredLabour")
  coveredPartLines   JobCardPart[]   @relation("ClaimCoveredParts")

  @@index([tenantId, claimJobCardId])
  @@index([tenantId, status])
  @@map("warranty_claims")
}

// ───────────────────────── GST EXPORT ─────────────────────────

// Append-only log of every GST/Tally export actually downloaded (not
// preview requests) — no update/delete, same discipline as AuditLog/
// DeliveryLog. Exists so a re-export of an overlapping period can be
// diffed against what was already handed to the accountant (see
// export-manifest-diff.ts) rather than silently producing a second,
// undistinguished batch that risks double-import in Tally.
model GstExportBatch {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Human-readable, e.g. "GSTEXP-0004" — via the shared generateSequenceNumber
  // helper (entityType "GST_EXPORT"), same convention as invoice/job-card numbers.
  batchNumber String

  side   String // "sales" | "purchases"
  format String // "tally-xml" | "gstr-csv"

  periodFrom DateTime
  periodTo   DateTime

  generatedByUserId String
  generatedByUser   User     @relation(fields: [generatedByUserId], references: [id])
  generatedAt       DateTime @default(now())

  // One entry per voucher included in this export — {type, sourceId,
  // referenceNumber, amount} — used only to detect amendments on the NEXT
  // export covering an overlapping period (see export-manifest-diff.ts).
  // Not queried structurally, so a Json blob (not a child table) is the
  // right fit here.
  manifest Json

  @@unique([tenantId, batchNumber])
  @@index([tenantId, side, periodFrom, periodTo])
  @@map("gst_export_batches")
}
